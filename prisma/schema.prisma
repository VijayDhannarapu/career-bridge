// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  RECRUITER
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  userId       String        @id @default(uuid())
  clerkId      String        @unique
  name         String
  email        String        @unique
  role         Role
  applications Application[]
}

model Recruiter {
  recId      String    @id @default(uuid())
  clerkId    String    @unique
  name       String
  email      String    @unique
  officeName String
  imgUrl     String?
  role       Role
  createdAt  DateTime  @default(now())
  postJob    PostJob[]
}

model PostJob {
  postId       String        @id @default(uuid())
  title        String
  description  String
  category     String
  location     String
  level        String
  posted       DateTime      @default(now()) 
  ctc          Float
  recruiterId  String
  recruiter    Recruiter     @relation(fields: [recruiterId], references: [recId])
  applications Application[]
}

model Application {
  status Status @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [userId])

  postId  String
  postJob PostJob @relation(fields: [postId], references: [postId])

  appliedAt DateTime @default(now())

  @@id([userId, postId])
}